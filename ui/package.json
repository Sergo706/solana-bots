  "description": "Solana Trading Terminal and Bot Manager",
  "main": ".vite/build/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "build:workers": "vite build -c vite.worker.config.ts && vite build -c vite.opworker.config.ts",
