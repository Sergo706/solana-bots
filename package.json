{
  "name": "solana-bots",
  "version": "1.0.0",
  "main": "./dist/cli.mjs",
  "type": "module",
  "author": "Sergio contact@riavzon.com",
  "license": "MIT",
  "description": "CLI and utilities for managing multiple Solana wallets, encrypting private keys, and performing mass token swaps via Jupiter (devnet/mainnet).",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sergo706/solana-bots.git"
  },
  "homepage": "https://github.com/Sergo706/solana-bots#readme",
  "bugs": {
    "url": "https://github.com/Sergo706/solana-bots/issues"
  },
  "keywords": [
    "solana",
    "solana-bots",
    "trading",
    "bot trading",
    "jupiter",
    "swap",
    "jup",
    "wallets",
    "key-encryption",
    "drizzle-orm",
    "sqlite",
    "cli",
    "crypto",
    "devnet",
    "mainnet",
    "mass-sell",
    "bots"
  ],
  "bin": {
    "solana-bots": "./dist/cli.mjs"
  },
  "pkg": {
    "assets": [
      "dist/migrations/**/*"
    ],
    "targets": [
      "linux",
      "macos",
      "node20-win-x64"
    ],
    "outputPath": "build"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "default": "./dist/cli.mjs"
      }
    }
  },
  "scripts": {
    "migrate": "drizzle-kit generate && drizzle-kit push",
    "compile:linux": "bun build src/main.ts --compile --target bun-linux-x64 --outfile build/solana-bots-linux",
    "compile:windows": "bun build src/main.ts --compile --target bun-windows-x64 --outfile build/solana-bots-win.exe",
    "compile:macos": "bun build src/main.ts --compile --target bun-darwin-x64 --outfile build/solana-bots-macos",
    "compile:all": "npm run compile:linux && npm run compile:windows && npm run compile:macos",
    "build": "tsdown && npx drizzle-kit generate && cp -r src/db/migrations dist/migrations && npm run compile:all && cp -r dist/migrations build/migrations",
    "make-installer": "docker run --rm -v \"$PWD\":/work -w /work amake/innosetup installer.iss",
    "lint": "eslint .",
    "types": "npx tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@riavzon/utils": "^1.1.6",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.4",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
